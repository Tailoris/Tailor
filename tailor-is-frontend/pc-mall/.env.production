# PC Mall 生产环境配置
# 部署后由 Nginx 反向代理到 Core Gateway
VITE_API_BASE_URL=
VITE_APP_TITLE=Tailor IS 商城
VITE_APP_ENV=production
VITE_PORT=3000

# 网关地址 (相对路径, 由 Nginx 转发)
VITE_CORE_GATEWAY_URL=/api
VITE_LITE_GATEWAY_URL=/api/lite

# CDN 静态资源 (Phase 3 启用)
# VITE_CDN_BASE=https://cdn.tailoris.example.com

# GraphQL
VITE_GRAPHQL_ENDPOINT=/graphql

# 第三方服务
VITE_SENTRY_DSN=
