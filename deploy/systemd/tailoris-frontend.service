[Unit]
Description=Tailor IS Frontend Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=tailor
WorkingDirectory=/home/tailor/Tailoris/tailor-is-frontend/pc-mall
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/npm run dev
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tailoris-frontend

[Install]
WantedBy=multi-user.target