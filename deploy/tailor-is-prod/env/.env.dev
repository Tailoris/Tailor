# ===== 开发环境JVM轻量化参数（全局注入所有Java容器） =====
# 核心优化：强制JVM仅识别容器分配CPU，不读取宿主机全核心
# 降低单服务CPU占用从5~8% → 1~3%
# 使用G1GC减少Full GC频率和暂停时间

JAVA_OPTS_DEV=-XX:+UseContainerSupport -XX:ActiveProcessorCount=2 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:InitiatingHeapOccupancyPercent=45 -XX:G1ReservePercent=10 -XX:ParallelGCThreads=2 -XX:ConcGCThreads=1 -Xms128m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:-TieredCompilation -XX:MaxDirectMemorySize=64M -Dserver.tomcat.threads.max=40 -Dserver.tomcat.threads.min-spare=5 -Dserver.tomcat.max-connections=200 -Dserver.tomcat.accept-count=50 -Dspring.profiles.active=dev

