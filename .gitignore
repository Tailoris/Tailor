# ============================================================
# Tailor IS 项目 .gitignore
# ============================================================

# ===== 敏感信息（CRITICAL） =====
.env
.env.local
.env.production
**/*.pem
**/*.key
**/credentials.json
**/secrets.yml

# ===== IDE =====
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ===== Java / Maven =====
target/
*.class
*.jar
*.war
*.ear
*.log
*.pid
hs_err_pid*

# ===== Node.js / 前端 =====
node_modules/
dist/
.nuxt/
.output/
.turbo/
*.tsbuildinfo
.eslintcache

# ===== Docker =====
docker-compose.override.yml

# ===== OS =====
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ===== 临时文件 =====
*.tmp
*.bak
*.cache
__pycache__/
*.pyc

# ===== 日志 =====
logs/
*.log

# ===== 构建产物 =====
build/
out/
.gradle/

# ===== 测试覆盖率 =====
coverage/
.nyc_output/
jacoco/

# ===== SonarQube =====
.sonar/
.scannerwork/

# 数据库备份/演练目录
rto-drill/
backup_drill_*/

# 备份目录
rto-drill/
backup_drill_*/

# 数据库、压缩包类大文件
*.db
*.gz
*.tar
*.tar.gz
*.sql.gz

# 项目笔记、临时文档（按需保留）
.obsidian/
.claudian/
.trae/
*.tmp
*.bak

# ===== 废弃/备份文件 =====
*-old.*
*备份*
*-backup.*
*.old

# ===== 安装包/资源缓存 =====
*.deb
*.zip
*.tar.gz
*.rar

# ===== Python =====
venv/
.venv/

# ===== 编辑器缓存 =====
.obsidian/
.claudian/
.trae/

# ===== 测试报告临时文件 =====
test-report-*.txt

# ===== 前端构建产物（deploy 目录中） =====
deploy/tailor-is-prod/frontend/

# ===== 备份目录 =====
backup/
deploy/backups/

# ===== 项目清理脚本（已过期） =====
clean-project.sh
start-all.sh
