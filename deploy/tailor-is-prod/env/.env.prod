# ===== 生产环境JVM优化参数（全局注入所有Java容器） =====
# 核心优化：强制JVM仅识别容器分配CPU，不读取宿主机全核心
# 使用G1GC减少Full GC频率和暂停时间
# 启用TieredCompilation提升热点代码编译性能

JAVA_OPTS_PROD=-XX:+UseContainerSupport -XX:ActiveProcessorCount=4 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:InitiatingHeapOccupancyPercent=45 -XX:G1ReservePercent=10 -XX:ParallelGCThreads=4 -XX:ConcGCThreads=2 -Xms512m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:+TieredCompilation -XX:MaxDirectMemorySize=128M -Dserver.tomcat.threads.max=200 -Dserver.tomcat.threads.min-spare=20 -Dserver.tomcat.max-connections=1000 -Dserver.tomcat.accept-count=200 -Dspring.profiles.active=prod

# 生产环境安全配置
ALIPAY_APP_ID=${ALIPAY_APP_ID}
ALIPAY_PRIVATE_KEY=${ALIPAY_PRIVATE_KEY}
ALIPAY_PUBLIC_KEY=${ALIPAY_PUBLIC_KEY}
COPYRIGHT_AES_KEY=${COPYRIGHT_AES_KEY}