# ===== Tailor IS 基础公共环境变量 =====
# 时区
TZ=Asia/Shanghai

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# 禁用 Sentinel（本地开发避免日志锁问题）
SPRING_CLOUD_SENTINEL_ENABLED=false

# Nacos
NACOS_ADDR=host.docker.internal:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=dev
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=host.docker.internal:8848
SPRING_CLOUD_NACOS_DISCOVERY_ENABLED=true
SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR=host.docker.internal:8848

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=redis_jD2N8n

# RabbitMQ
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_USERNAME=rabbitmq

# MySQL
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=mysql_ZmY2sr
MYSQL_ROOT_PASSWORD=mysql_ZmY2sr

# 安全
AES_KEY=Al9Curr89MtRcS3L0av5s1LSMlYxBvHnohUzi/0wENc=
COPYRIGHT_AES_KEY=Ta1lorIS-C0pyright-DevKey-2026!!
