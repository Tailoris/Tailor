# ==============================================================================
# Tailor IS - User Service 多阶段构建 Dockerfile
# ==============================================================================
# 修复 H-07: 使用多阶段构建，减小最终镜像体积
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: 构建阶段 - 包含完整的构建工具
# ------------------------------------------------------------------------------
FROM maven:3.9.6-eclipse-temurin-17 AS builder

LABEL maintainer="Tailor IS Team"
LABEL description="Tailor IS user service builder"
LABEL version="1.0.0"

WORKDIR /build

# 先复制 pom.xml，利用 Docker 缓存加速依赖下载
COPY pom.xml .
COPY tailor-is-user/pom.xml tailor-is-user/
COPY tailor-is-common/pom.xml tailor-is-common/
COPY tailor-is-dependencies/pom.xml tailor-is-dependencies/ 2>/dev/null || true

# 下载依赖（缓存层）
RUN mvn dependency:go-offline -B -pl tailor-is-user -am 2>/dev/null || true

# 复制源代码并构建
COPY . .

# 跳过测试以加快构建速度（生产镜像）
RUN mvn clean package -B -DskipTests \
    -pl tailor-is-user \
    -am \
    -T 1C

# ------------------------------------------------------------------------------
# Stage 2: 运行阶段 - 仅包含 JRE，体积更小
# ------------------------------------------------------------------------------
FROM eclipse-temurin:17-jre-jammy AS runtime

LABEL maintainer="Tailor IS Team"
LABEL description="Tailor IS tailor-is-user"
LABEL version="1.0.0"

WORKDIR /app

# 安装必要工具
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends curl ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# JVM 参数（容器感知）
ENV JVM_XMX=512m
ENV JVM_XMS=256m
ENV SERVER_PORT=8101
ENV SPRING_PROFILES_ACTIVE=prod

EXPOSE 8101

# 从构建阶段复制 jar
COPY --from=builder /build/tailor-is-user/target/*.jar /app/app.jar

# 创建非 root 用户
RUN groupadd --system tailor \
    && useradd --system -g tailor tailor \
    && chown -R tailor:tailor /app
USER tailor

# 启动应用
ENTRYPOINT ["sh", "-c", "java \
    -XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:+ExitOnOutOfMemoryError \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/tmp/heapdump.hprof \
    -Duser.timezone=${TZ} \
    -Dserver.port=${SERVER_PORT} \
    -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE} \
    -Xmx${JVM_XMX} -Xms${JVM_XMS} \
    -jar /app/app.jar \
"]

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${SERVER_PORT}/actuator/health || exit 1
