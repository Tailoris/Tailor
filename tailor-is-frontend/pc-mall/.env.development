# pc-mall 使用空 baseURL + 完整路径策略（如 /api/v1/auth/login）
# Vite 代理将请求转发到网关，与其他项目（/api/v1 相对路径）策略不同但功能等价
VITE_API_BASE_URL=
VITE_APP_TITLE=Tailor IS PC Mall
VITE_APP_ENV=development
VITE_PORT=5173
# Gateway split configuration
VITE_CORE_GATEWAY_URL=http://localhost:9000
VITE_LITE_GATEWAY_URL=http://localhost:8081
